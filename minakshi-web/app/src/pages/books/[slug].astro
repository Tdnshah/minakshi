---
export const prerender = false;

import BookLayout from "../../layouts/BookLayout.astro";
import BookHero from "../../components/BookHero.astro";
import BuyButton from "../../components/BuyButton.astro";
import BookThemes from "../../components/BookThemes.astro";
import BookExcerpt from "../../components/BookExcerpt.astro";
import BookBehind from "../../components/BookBehind.astro";
import BookPullQuote from "../../components/BookPullQuote.astro";
import BookPressGrid from "../../components/system/BookPressGrid.astro";
import BlockRenderer from "../../components/blocks/BlockRenderer.astro";
import type { BookBlock } from "../../components/blocks/types";
import BookAwards from "../../components/BookAwards.astro";
import BookEvents from "../../components/BookEvents.astro";
import EventGallery from "../../components/EventGallery.astro";
import { fetchBookBySlug } from "../../lib/payload/books";
import { lexicalToHtml } from "../../lib/lexical";

const { slug } = Astro.params;
const currentPath = Astro.url.pathname;

if (!slug) return Astro.redirect("/books");

const book = await fetchBookBySlug(slug);

if (!book) {
    return new Response(
        `<!doctype html><html><head><title>Book not found</title></head><body style="font-family:sans-serif;text-align:center;padding:4rem">
            <h1>Book not found</h1>
            <p>The CMS may still be starting up — please try again in a moment.</p>
            <p><a href="/books">← Back to Books</a></p>
        </body></html>`,
        { status: 404, headers: { 'Content-Type': 'text/html' } }
    );
}

let descriptionHtml = book.description ? lexicalToHtml(book.description) : "";
let descriptionTitle = "About the book";

// Extract h2 from description if present and use it as the section title
if (descriptionHtml) {
    const h2Match = descriptionHtml.match(/<h2[^>]*>(.*?)<\/h2>/);
    if (h2Match) {
        descriptionTitle = h2Match[1];
        descriptionHtml = descriptionHtml.replace(/<h2[^>]*>.*?<\/h2>/, "");
    }
}

const coverUrl = book.coverImage?.url ?? "";

const galleryImages = (book.eventGallery ?? [])
    .filter((g) => g.image?.url)
    .map((g) => ({ url: g.image!.url, alt: g.image!.alt ?? "", caption: g.caption ?? "" }));

const reviewItems = (book.reviews ?? []).map((r) => ({
    id: r.id,
    quote: r.quote,
    publication: r.author,
    url: r.source,
}));

const mediaItems = (book.mediaCoverage ?? []).map((m) => ({
    id: m.id,
    title: m.title,
    publication: m.reviewer,
    url: m.url,
    type: m.type,
    date: m.date,
}));

const formattedReleaseDate = book.releaseDate
    ? new Date(book.releaseDate).toLocaleDateString("en-US", {
        month: "long",
        year: "numeric",
    })
    : "";

---

<BookLayout title={book.title} description={typeof book.description === 'string' ? book.description : book.title}>

    <!-- ① Hero: cover + metadata + buy links -->
    <BookHero
        title={book.title}
        subtitle={book.subtitle}
        excerpt={book.excerpt}
        coverImage={coverUrl}
        coverAlt={`Cover of ${book.title}`}
        publisher={book.publisher}
        releaseDate={formattedReleaseDate}
        awardsCount={book.awards?.length ?? 0}
    >
        <Fragment slot="buy">
            {book.buyLinks?.map((link) => (
                <BuyButton href={link.url} label={`Buy on ${link.store}`} variant="primary" />
            ))}
        </Fragment>
    </BookHero>

    <!-- ② Synopsis / About the Book -->
    {descriptionHtml && (
        <section class="synopsis">
            <div class="container">
                <div class="synopsis-eyebrow-wrap">
                    {/* <p class="eyebrow">About the book</p> */}
                    <h2>{descriptionTitle}</h2>
                </div>
                <div class="prose" set:html={descriptionHtml} />
            </div>
        </section>
    )}

    <!-- ③ Themes (optional — requires CMS fields) -->
    {(book.themes?.length ?? 0) > 0 && (
        <BookThemes themes={book.themes!} />
    )}

    <!-- ④ Featured Excerpt (optional — requires CMS fields) -->
    {book.excerptText && (
        <BookExcerpt
            eyebrow={book.excerptEyebrow ?? "An excerpt"}
            title={book.excerptTitle ?? ""}
            paragraphs={[book.excerptText]}
            cite={book.excerptCite ?? ""}
        />
    )}

    <!-- ⑤a Press & Reviews — reader quotes -->
    {reviewItems.length > 0 && (
        <BookPressGrid
            items={reviewItems}
            eyebrow="What reviewers have to say"
            heading=""
            headingItalic=""
        />
    )}

    <!-- ⑤b Media Coverage — articles, interviews, features -->
    {mediaItems.length > 0 && (
        <BookPressGrid
            items={mediaItems}
            eyebrow="As seen in"
            heading="Media"
            headingItalic="coverage"
        />
    )}

    <!-- ⑥ Awards & Recognition -->
    {(book.awards?.length ?? 0) > 0 && (
        <BookAwards awards={book.awards!} />
    )}

    <!-- ⑦ Behind the Book (optional — requires CMS fields) -->
    {(book.behindStats?.length ?? 0) > 0 && (
        <BookBehind stats={book.behindStats!} />
    )}

    <!-- ⑧ Events / Book Tour -->
    {(book.bookEvents?.length ?? 0) > 0 && (
        <BookEvents events={book.bookEvents!} />
    )}

    <!-- ⑨ Event Gallery -->
    {galleryImages.length > 0 && (
        <EventGallery images={galleryImages} />
    )}

    <!-- ⑩ Pull Quote (optional — requires CMS fields) -->
    {book.pullQuote && (
        <BookPullQuote
            quote={book.pullQuote}
            cite={book.pullQuoteCite}
        />
    )}

    <!-- ⑪ Extra blocks from the book block builder -->
    {(book.blocks?.length ?? 0) > 0 && (
        <BlockRenderer blocks={book.blocks as BookBlock[]} />
    )}

    <!-- ⑫ Discussion -->
    <section class="discuss-section">
        <div class="container">
            <h2 class="discuss-heading">Discuss this book</h2>
            <p class="discuss-sub">Have thoughts? Leave a comment below.</p>
            <div
                id="cusdis_thread"
                data-host="https://cusdis.com"
                data-app-id="74263bf9-1702-4d80-b5f5-1c3bb8c974cb"
                data-page-id={slug}
                data-page-url={currentPath}
                data-page-title={book.title}
            />
        </div>
    </section>

</BookLayout>

<style>
    /* ── Synopsis ── */
    .synopsis {
        padding: 5rem 0;
        background: var(--paper);
        border-bottom: 1px solid var(--ink);
    }

    .synopsis-eyebrow-wrap {
        margin-bottom: 2rem;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--accent);
        margin: 0;
    }

    .eyebrow::before {
        content: '';
        display: inline-block;
        width: 1.5rem;
        height: 1px;
        background: var(--accent);
    }

    /* Prose block: centered in container, text stays left-aligned */
    .prose {
        max-width: 68ch;
        margin: 0 auto;
    }

    .prose :global(p) {
        font-family: var(--font-body);
        font-size: 1.0625rem;
        line-height: 1.75;
        color: var(--ink-mid);
        margin: 0 0 2rem 0;
    }

    .prose :global(p:last-child) { margin-bottom: 0; }

    .prose :global(h1) {
        font-family: var(--font-display);
        font-size: 2rem;
        font-weight: 600;
        line-height: 1.3;
        color: var(--ink);
        margin: 3.5rem 0 2rem 0;
    }

    .prose :global(h2) {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 600;
        line-height: 1.3;
        color: var(--ink);
        margin: 3rem 0 1.75rem 0;
    }

    .prose :global(h3) {
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.4;
        color: var(--ink);
        margin: 2.5rem 0 1.5rem 0;
    }

    .prose :global(h4) {
        font-family: var(--font-display);
        font-size: 1.125rem;
        font-weight: 600;
        line-height: 1.4;
        color: var(--ink);
        margin: 2rem 0 1.25rem 0;
    }

    .prose :global(ul),
    .prose :global(ol) {
        margin: 1.5rem 0;
        padding-left: 1.75rem;
    }

    .prose :global(li) {
        font-family: var(--font-body);
        font-size: 1.0625rem;
        line-height: 1.75;
        color: var(--ink-mid);
        margin-bottom: 0.5rem;
    }

    .prose :global(blockquote) {
        margin: 1.75rem 0;
        padding-left: 1.5rem;
        border-left: 3px solid var(--accent);
        font-style: italic;
        color: var(--ink-mid);
    }

    .prose :global(hr) {
        margin: 2.5rem 0;
        border: none;
        border-top: 1px solid var(--rule-soft);
    }

    .prose :global(figure) {
        margin: 2rem 0;
    }

    .prose :global(figure img) {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 0.5rem;
    }

    .prose :global(figcaption) {
        margin-top: 0.75rem;
        font-size: 0.95rem;
        color: var(--ink-soft);
        font-style: italic;
    }

    .prose :global(code) {
        font-family: var(--font-mono);
        font-size: 0.9em;
        background: var(--paper-soft);
        color: var(--accent);
        padding: 0.2em 0.4em;
        border-radius: 0.25rem;
    }

    .prose :global(u) {
        text-decoration: underline;
        text-decoration-style: solid;
        text-underline-offset: 2px;
    }

    .prose :global(s) {
        text-decoration: line-through;
        color: var(--ink-soft);
    }

    .prose :global(sub),
    .prose :global(sup) {
        font-size: 0.85em;
        line-height: 0;
        position: relative;
        vertical-align: baseline;
    }

    .prose :global(sup) {
        top: -0.5em;
    }

    .prose :global(sub) {
        bottom: -0.25em;
    }

    .media-columns {
        display: grid;
        gap: 1.5rem;
        margin: 2rem 0;
    }

    .media-columns--2col {
        grid-template-columns: repeat(2, 1fr);
    }

    .media-columns--3col {
        grid-template-columns: repeat(3, 1fr);
    }

    .media-columns--4col {
        grid-template-columns: repeat(4, 1fr);
    }

    .media-columns figure {
        margin: 0;
    }

    .media-columns figcaption {
        margin-top: 0.75rem;
        font-size: 0.9rem;
        color: var(--ink-soft);
    }

    @media (max-width: 768px) {
        .media-columns--3col,
        .media-columns--4col {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .media-columns--2col,
        .media-columns--3col,
        .media-columns--4col {
            grid-template-columns: 1fr;
        }
    }

    .prose :global(em) {
        color: var(--ink);
    }

    .prose :global(strong) {
        font-weight: 600;
        color: var(--ink);
    }

    .prose :global(a) {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 2px;
        transition: color 0.15s var(--ease-editorial);
    }

    .prose :global(a:hover) {
        color: var(--accent-deep);
    }

    /* ── Discussion ── */
    .discuss-section {
        padding: 5rem 0;
        background: var(--paper);
        border-top: 1px solid var(--ink);
    }

    .discuss-heading {
        font-family: var(--font-display);
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 500;
        color: var(--ink);
        margin-bottom: 0.5rem;
        font-variation-settings: "opsz" 36, "SOFT" 30;
    }

    .discuss-sub {
        font-family: var(--font-body);
        font-size: 1rem;
        color: var(--ink-mid);
        margin-bottom: 2rem;
    }

    @media (max-width: 768px) {
        .synopsis,
        .discuss-section {
            padding: 3.5rem 0;
        }
    }
</style>
