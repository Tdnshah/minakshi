---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchPodcasts } from "../../lib/payload/podcasts";
import { fetchInterviews } from "../../lib/payload/interviews";
import PageHeader from "../../components/system/PageHeader.astro";
import SectionHeader from "../../components/system/SectionHeader.astro";
export const prerender = false;

const podcasts = await fetchPodcasts();
const sortedPodcasts = podcasts.sort(
    (a, b) => new Date(b.publishedAt) - new Date(a.publishedAt),
);

const interviews = await fetchInterviews();
const sortedInterviews = interviews.sort(
    (a, b) => new Date(b.publishedAt) - new Date(a.publishedAt),
);

// Format date helper
const formatDate = (date: Date) => {
    return new Intl.DateTimeFormat("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    }).format(date);
};
---

<BaseLayout title="Podcasts & Interviews">
    <section class="section">
        <div class="container">
            <PageHeader
                eyebrow="Audio & Video"
                title="Podcasts & Interviews"
                description="In conversation: interviews and long-form discussions with Minakshi Dewan"
            />
            <div>
                <SectionHeader
                    eyebrow="Series"
                    title="Podcasts"
                    italicPart="archive."
                />
                 <div class="podcasts-grid">
                    {
                        sortedPodcasts.map((podcast) => (
                            <a
                                href={`/podcasts/${podcast.id}`}
                                class="podcast-card"
                            >
                                <article>
                                    <div class="podcast-content">
                                        <div class="podcast-meta">
                                            <span class="platform-badge">
                                                {podcast.platform}
                                            </span>
                                            <time
                                                datetime={podcast.publishedAt.toISOString()}
                                            >
                                                {formatDate(
                                                    podcast.publishedAt,
                                                )}
                                            </time>
                                        </div>
                                        <h2 class="podcast-title">
                                            {podcast.title}
                                        </h2>
                                        {podcast.description && (
                                            <p class="podcast-description">
                                                {podcast.description}
                                            </p>
                                        )}
                                        <span class="read-more">
                                            Listen / Watch →
                                        </span>
                                    </div>
                                </article>
                            </a>
                        ))
                    }
                </div>
            </div>
            <div>
                <SectionHeader
                    eyebrow="Features"
                    title="Interviews"
                    italicPart="archive."
                />
                 <div class="podcasts-grid">
                    {
                        sortedInterviews.map((interview) => (
                            <a
                                href={`/podcasts/${interview.id}`}
                                class="podcast-card"
                            >
                                <article>
                                    <div class="podcast-content">
                                        <div class="podcast-meta">
                                            <span class="platform-badge">
                                                {interview.platform}
                                            </span>
                                            <time
                                                datetime={interview.publishedAt.toISOString()}
                                            >
                                                {formatDate(
                                                    interview.publishedAt,
                                                )}
                                            </time>
                                        </div>
                                        <h2 class="podcast-title">
                                            {interview.title}
                                        </h2>
                                        {interview.description && (
                                            <p class="podcast-description">
                                                {interview.description}
                                            </p>
                                        )}
                                        <span class="read-more">
                                            Listen / Watch →
                                        </span>
                                    </div>
                                </article>
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .podcasts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .podcast-card {
        text-decoration: none;
        color: inherit;
        background: var(--paper-soft);
        border: 1px solid var(--rule-soft);
        transition: border-color 0.24s var(--ease-editorial), transform 0.24s var(--ease-editorial);
        display: flex;
        flex-direction: column;
    }

    .podcast-card:hover {
        border-color: var(--ink);
        transform: translateY(-2px);
    }

    .podcast-content {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .podcast-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.875rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.1em;
        color: var(--ink-soft);
    }

    .platform-badge {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--accent);
    }

    .podcast-meta time {
        text-transform: uppercase;
    }

    .podcast-title {
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 500;
        letter-spacing: -0.015em;
        font-variation-settings: "opsz" 36, "SOFT" 30, "WONK" 0;
        margin-bottom: 0.75rem;
        line-height: 1.25;
        color: var(--ink);
    }

    .podcast-description {
        font-family: var(--font-body);
        font-size: 0.9375rem;
        color: var(--ink-mid);
        margin-bottom: 1.25rem;
        line-height: 1.65;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex-grow: 1;
    }

    .read-more {
        font-family: var(--font-body);
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--accent);
        border-bottom: 1px solid var(--accent);
        padding-bottom: 1px;
        align-self: flex-start;
        transition: color 0.15s var(--ease-editorial), border-color 0.15s var(--ease-editorial);
        margin-top: auto;
    }

    .podcast-card:hover .read-more {
        color: var(--accent-deep);
        border-color: var(--accent-deep);
    }
</style>
