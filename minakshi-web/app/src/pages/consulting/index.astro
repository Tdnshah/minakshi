---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchConsulting } from "../../lib/payload/consulting";
import { fetchFilms } from "../../lib/payload/films";
import PageHeader from "../../components/system/PageHeader.astro";
import SectionHeader from "../../components/system/SectionHeader.astro";
import ThemedCard from "../../components/system/ThemedCard.astro";
import EventCard from "../../components/system/EventCard.astro";
export const prerender = false;

const consulting = await fetchConsulting();
const films = await fetchFilms();
---

<BaseLayout title="Consulting & Collaborations">
    <section class="section">
        <div class="container">
            <PageHeader
                eyebrow="Practice"
                title="Consulting & Collaborations"
                description="Policy, research, and interdisciplinary collaborations spanning development, health, and media."
            />

            <div class="intro">
                <p>
                    Dewan brings over two decades of experience in research, policy writing, and program consulting across development, health, gender, and cultural sectors. Her work spans grassroots organisations, international think tanks, and academic institutions.
                </p>
            </div>

            <SectionHeader
                eyebrow="Advisory"
                title="Development"
                italicPart="consulting."
            />
            <div class="consulting-grid">
                {
                    consulting.map((project) => (
                        <ThemedCard
                            eyebrow={project.year}
                            title={project.organisation}
                            subtitle={project.title}
                            description={project.description}
                            tags={project.domain}
                        />
                    ))
                }
            </div>

            <SectionHeader
                eyebrow="Creative Partnerships"
                title="Film & Documentary"
                italicPart="collaborations."
            />

            <div class="intro">
                <p>
                    Documentary and film projects that extend her research into visual and narrative formats, developed in collaboration with filmmakers and cultural institutions.
                </p>
            </div>

            <div class="films-list">
                {
                    films.map((film) => (
                        <EventCard
                            title={film.title}
                            meta={[
                                `with ${film.collaborator}`,
                                ...(film.expectedRelease
                                    ? [`Expected ${film.expectedRelease}`]
                                    : []),
                            ]}
                            description={film.description}
                            note={film.notes}
                        />
                    ))
                }
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .intro {
        max-width: var(--prose, 68ch);
        margin: 0 auto 3rem;
        text-align: center;
        font-family: var(--font-display);
        font-style: italic;
        font-size: 1.1rem;
        line-height: 1.6;
        color: var(--ink-mid);
        font-variation-settings: "opsz" 24, "SOFT" 50;
    }

    .consulting-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1px;
        background: var(--ink);
        border: 1px solid var(--ink);
        margin-bottom: 3.5rem;
    }

    .films-list {
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--ink);
    }
</style>
