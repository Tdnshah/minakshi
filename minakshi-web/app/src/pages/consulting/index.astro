---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchConsulting } from "../../lib/payload/consulting";
import { fetchFilms } from "../../lib/payload/films";
import PageHeader from "../../components/system/PageHeader.astro";
import SectionHeader from "../../components/system/SectionHeader.astro";
import ThemedCard from "../../components/system/ThemedCard.astro";
import EventCard from "../../components/system/EventCard.astro";
export const prerender = false;

const consulting = await fetchConsulting();
const films = await fetchFilms();

const EXCERPT_LENGTH = 160;

// Latest first; year is an optional string from the CMS, so compare numerically
// and push entries without a year to the end. Copy before sorting.
const yearOf = (y?: string) => parseInt(y ?? "", 10) || 0;
const sortedConsulting = [...consulting].sort(
    (a, b) => yearOf(b.year) - yearOf(a.year),
);
---

<BaseLayout title="Consulting & Collaborations">
    <section class="section">
        <div class="container">
            <PageHeader
                eyebrow="Practice"
                title="Consulting & Collaborations"
                description="Policy, research, and interdisciplinary collaborations spanning development, health, and media"
            />

            <div class="intro">
                <p>
                    Dewan brings over two decades of experience in research, policy writing, and program consulting across development, health, gender, and cultural sectors. Her work spans grassroots organisations, international think tanks, and academic institutions.
                </p>
            </div>

            <SectionHeader
                eyebrow="Advisory"
                title="Development"
                italicPart="consulting"
            />
            <div class="consulting-grid">
                {
                    sortedConsulting.map((project) => (
                        <ThemedCard
                            // eyebrow={project.year}
                            title={project.organisation}
                            subtitle={project.title}
                            description={
                                project.description.length > EXCERPT_LENGTH
                                    ? `${project.description.slice(0, EXCERPT_LENGTH).trim()}...`
                                    : project.description
                            }
                            tags={project.domain}
                            href={
                                project.description.length > EXCERPT_LENGTH
                                    ? `/consulting/${project.slug}`
                                    : undefined
                            }
                        />
                    ))
                }
            </div>

            <SectionHeader
                eyebrow="Creative Partnerships"
                title="Film & Documentary"
                italicPart="collaborations"
            />

            <div class="intro">
                <p>
                    Documentary and film projects that extend her research into visual and narrative formats, developed in collaboration with filmmakers and cultural institutions.
                </p>
            </div>

            <div class="films-list">
                {
                    films.map((film) => (
                        <EventCard
                            title={film.title}
                            meta={[
                                `with ${film.collaborator}`,
                                ...(film.expectedRelease
                                    ? [`Expected ${film.expectedRelease}`]
                                    : []),
                            ]}
                            description={film.description}
                            note={film.notes}
                        />
                    ))
                }
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .intro {
        max-width: var(--prose, 68ch);
        margin: 0 0 3rem;
        font-family: var(--font-display);
        font-size: 1.1rem;
        line-height: 1.6;
        color: var(--ink-mid);
        font-variation-settings: "opsz" 24, "SOFT" 50;
    }

    .consulting-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        /* Hairlines are drawn per card (not via a filled grid background) so an
           incomplete last row doesn't show empty ink-coloured cells. */
        border-top: 1px solid var(--ink);
        border-left: 1px solid var(--ink);
        margin-bottom: 3.5rem;
    }

    /* Each card spans 5 grid rows and inherits them via subgrid, so title,
       subtitle, description, tags and link line up across cards in a row
       whatever their content height. Explicit rows keep a missing subtitle
       or link from shifting the others. */
    .consulting-grid > :global(.themed-card) {
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
        display: grid;
        grid-row: span 5;
        grid-template-rows: subgrid;
        row-gap: 0.875rem;
        align-content: start;
    }

    .consulting-grid > :global(.themed-card > .themed-title) {
        grid-row: 1;
    }
    .consulting-grid > :global(.themed-card > .themed-subtitle) {
        grid-row: 2;
    }
    .consulting-grid > :global(.themed-card > .themed-description) {
        grid-row: 3;
    }
    .consulting-grid > :global(.themed-card > .themed-tags) {
        grid-row: 4;
        margin-top: 0;
        padding-top: 0;
        align-self: start;
    }
    .consulting-grid > :global(.themed-card > .themed-action) {
        grid-row: 5;
        margin-top: 0;
        align-self: start;
    }

    .films-list {
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--ink);
    }
</style>
