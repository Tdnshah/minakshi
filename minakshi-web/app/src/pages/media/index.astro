---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchPress } from "../../lib/payload/press";
import PressGrid from "../../components/PressGrid.astro";
import PageHeader from "../../components/system/PageHeader.astro";
import SectionHeader from "../../components/system/SectionHeader.astro";
export const prerender = false;

const sortedPress = await fetchPress();
---

<BaseLayout title="Media & Press">
    <section class="section">
        <div class="container">
            <PageHeader
                eyebrow="Coverage"
                title="Media & Press"
                description="Interviews and media coverage across print and broadcast platforms."
            />

            <div class="media-section">
                <SectionHeader
                    eyebrow="Archive"
                    title="Press"
                    italicPart="appearances."
                />
                <PressGrid items={sortedPress} />
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .media-section {
        margin-bottom: var(--spacing-xl);
    }
</style>
