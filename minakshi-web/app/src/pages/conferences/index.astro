---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchConferences } from "../../lib/payload/conferences";
import PageHeader from "../../components/system/PageHeader.astro";
import EventCard from "../../components/system/EventCard.astro";
export const prerender = false;

const conferences = await fetchConferences();
const sortedConferences = conferences.sort((a, b) => b.year - a.year);

// Group by year
const groupedByYear = sortedConferences.reduce(
    (acc, conf) => {
        const year = conf.year;
        if (!acc[year]) {
            acc[year] = [];
        }
        acc[year].push(conf);
        return acc;
    },
    {} as Record<number, typeof conferences>,
);

const years = Object.keys(groupedByYear)
    .map(Number)
    .sort((a, b) => b - a);
---

<BaseLayout title="Conferences & Workshops">
    <section class="section">
        <div class="container">
            <PageHeader
                eyebrow="Events"
                title="Conferences & Workshops"
                description="Selected talks, papers, and panels across anthropology, public health, and death studies."
            />
              <div class="intro">
                <p>
                Minakshi has actively participated in national and international conferences, presenting research and engaging in dialogues at the intersections of death studies, traditional healing, gender, and social anthropology. 
                </p>
                <p>
                Her work has been featured at prestigious platforms such as the American Anthropological Association (Tampa), the Death, Dying and Disposal International Conference (Utrecht), and Jawaharlal Nehru University (New Delhi), among others.
                </p>
                <p>
                    Through papers, panel discussions, and invited talks, she brings an ethnographic lens to complex questions of ritual, care, caste, and cultural meanings of death and healing. Her participation in these forums reflects an ongoing commitment to bridging academic research with lived experiences and public understanding.
                </p>
            </div>
            {
                years.map((year) => (
                    <div class="year-section">
                        <h2 class="year-title">{year}</h2>
                        <div class="conferences-list">
                            {groupedByYear[year].map((conf) => (
                                <EventCard
                                    title={conf.title}
                                    meta={[conf.institution, conf.location]}
                                    description={conf.abstract}
                                    links={conf.mediaLinks}
                                />
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </section>
</BaseLayout>

<style>
    .intro {
        max-width: var(--prose, 68ch);
        margin: 0 0 3rem;
        font-family: var(--font-display);
        font-size: 1.1rem;
        line-height: 1.6;
        color: var(--ink-mid);
        font-variation-settings: "opsz" 24, "SOFT" 50;
    }

    .year-section {
        margin-bottom: 3.5rem;
    }

    .year-title {
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--ink);
    }

    .conferences-list {
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--ink);
    }
</style>
