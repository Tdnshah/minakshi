# --- Payload CMS client (Astro frontend) ---

# Base URL of the Payload CMS instance this site fetches content from.
PAYLOAD_URL=http://localhost:3002

# API key for a Payload user with read access. Used both by the Astro
# server-side fetch helpers (src/lib/payload/client.ts) and by the one-off
# migration scripts under src/content/scripts/. Generate one in the Payload
# admin (Users -> API Key) and never commit the real value.
PAYLOAD_API_KEY=replace-with-a-payload-api-key

# --- Email Configuration (Contact Form) ---

# SMTP server host (e.g., smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# SMTP server port (typically 587 for TLS, 465 for SSL)
SMTP_PORT=587

# Use SSL/TLS encryption (true for port 465, false for port 587)
SMTP_SECURE=false

# SMTP authentication username
SMTP_USER=your-email@gmail.com

# SMTP authentication password (for Gmail, use an App Password, not your main password)
# Generate Gmail App Password: https://support.google.com/accounts/answer/185833
SMTP_PASSWORD=your-app-password

# Email sender address (the "from" address in outgoing emails)
SMTP_FROM=noreply@minakshidewan.com

# Email address where contact form submissions will be sent
CONTACT_EMAIL=your-email@gmail.com
